<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | CrmOne</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brandBlue: "#1a73e8",
              brandOrange: "#f97316",
            },
          },
        },
      };
    </script>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900">
    <div class="flex min-h-screen">
      <aside class="hidden w-72 flex-col bg-slate-950 px-6 py-8 text-white lg:flex">
        <div>
          <div class="inline-flex rounded-full bg-brandBlue/20 px-4 py-1 text-sm font-semibold text-blue-200">
            CrmOne
          </div>
          <h2 class="mt-4 text-2xl font-bold">Admin Panel</h2>
        </div>

        <nav class="mt-10 space-y-2">
          <a href="/api/dashboard" class="block rounded-2xl px-4 py-3 font-medium text-slate-300 transition hover:bg-slate-900 hover:text-white">Dashboard</a>
          <a href="/api/users" class="block rounded-2xl px-4 py-3 font-medium text-slate-300 transition hover:bg-slate-900 hover:text-white">Users</a>
          <a href="/api/companies" class="block rounded-2xl px-4 py-3 font-medium text-slate-300 transition hover:bg-slate-900 hover:text-white">Companies</a>
          <a href="/api/plans" class="block rounded-2xl bg-brandBlue px-4 py-3 font-medium text-white">Plans</a>
        </nav>

        <form action="/api/logout" method="POST" class="mt-auto">
          <button class="w-full rounded-2xl border border-slate-700 px-4 py-3 text-left font-medium text-slate-300 transition hover:border-slate-500 hover:text-white">
            Logout
          </button>
        </form>
      </aside>

      <main class="flex-1 p-4 sm:p-8">
        <div class="mb-8 flex flex-col gap-4 rounded-3xl bg-white p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-medium uppercase tracking-[0.2em] text-brandOrange">Configuration</p>
            <h1 class="mt-2 text-3xl font-bold">Subscription Plans</h1>
          </div>
          <button onclick="document.getElementById('add-plan-modal').classList.remove('hidden')" class="rounded-2xl bg-brandBlue px-6 py-3 text-sm font-bold text-white shadow-lg transition hover:bg-blue-700">
            + Create New Plan
          </button>
        </div>

        <% if (successMessages.length) { %>
          <div class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
            <%= successMessages[0] %>
          </div>
        <% } %>

        <% if (errorMessages.length) { %>
          <div class="mb-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <%= errorMessages[0] %>
          </div>
        <% } %>

        <section class="rounded-3xl bg-white p-6 shadow-sm">
          <div class="overflow-x-auto">
            <table class="min-w-full text-left text-sm">
              <thead class="border-b border-slate-200 text-slate-500">
                <tr>
                  <th class="pb-3 pr-6 font-medium">Plan Name</th>
                  <th class="pb-3 pr-6 font-medium">Yearly Price</th>
                  <th class="pb-3 pr-6 font-medium">Monthly Price</th>
                  <th class="pb-3 pr-6 font-medium">Max Users</th>
                  <th class="pb-3 pr-6 font-medium">Billing</th>
                  <th class="pb-3 font-medium text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% plans.forEach((plan) => { %>
                  <tr>
                    <td class="py-4 pr-6 font-semibold text-slate-900"><%= plan.name %></td>
                    <td class="py-4 pr-6 text-slate-600">$<%= plan.price_yearly %></td>
                    <td class="py-4 pr-6 text-slate-600">$<%= plan.price_monthly %></td>
                    <td class="py-4 pr-6 text-slate-600"><%= plan.max_users %></td>
                    <td class="py-4 pr-6 capitalize text-slate-600"><%= plan.billing_cycle %></td>
                    <td class="py-4 text-right">
                      <div class="flex justify-end gap-2">
                        <button onclick='editPlan(<%= JSON.stringify(plan) %>)' class="rounded-full bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-200">
                          Edit
                        </button>
                        <form action="/api/plans/<%= plan.id %>/delete" method="POST" onsubmit="return confirm('Delete this plan?');">
                          <button class="rounded-full bg-red-50 px-3 py-2 text-xs font-semibold text-red-600 transition hover:bg-red-100">
                            Delete
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>

    <!-- Add/Edit Modal -->
    <div id="add-plan-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/50 backdrop-blur-sm">
      <div class="w-full max-w-md rounded-3xl bg-white p-8 shadow-2xl">
        <h2 id="modal-title" class="text-2xl font-bold text-slate-900">Create New Plan</h2>
        <form id="plan-form" action="/api/plans" method="POST" class="mt-6 space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700">Plan Name</label>
            <input type="text" name="name" id="plan-name" required class="mt-1 block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm focus:border-brandBlue focus:outline-none focus:ring-1 focus:ring-brandBlue">
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700">Yearly Price ($)</label>
              <input type="number" name="price_yearly" id="plan-yearly" required class="mt-1 block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm focus:border-brandBlue focus:outline-none focus:ring-1 focus:ring-brandBlue">
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700">Monthly Price ($)</label>
              <input type="number" name="price_monthly" id="plan-monthly" required class="mt-1 block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm focus:border-brandBlue focus:outline-none focus:ring-1 focus:ring-brandBlue">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700">Max Users</label>
              <input type="number" name="max_users" id="plan-users" required class="mt-1 block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm focus:border-brandBlue focus:outline-none focus:ring-1 focus:ring-brandBlue">
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700">Billing Cycle</label>
              <select name="billing_cycle" id="plan-billing" class="mt-1 block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm focus:border-brandBlue focus:outline-none focus:ring-1 focus:ring-brandBlue">
                <option value="yearly">Yearly</option>
                <option value="monthly">Monthly</option>
              </select>
            </div>
          </div>
          <div class="mt-8 flex gap-3">
            <button type="button" onclick="closeModal()" class="flex-1 rounded-xl bg-slate-100 py-3 text-sm font-bold text-slate-600 transition hover:bg-slate-200">Cancel</button>
            <button type="submit" class="flex-1 rounded-xl bg-brandBlue py-3 text-sm font-bold text-white shadow-lg transition hover:bg-blue-700">Save Plan</button>
          </div>
        </form>
      </div>
    </div>

    <script>
      function closeModal() {
        document.getElementById('add-plan-modal').classList.add('hidden');
        document.getElementById('plan-form').action = '/api/plans';
        document.getElementById('modal-title').textContent = 'Create New Plan';
        document.getElementById('plan-form').reset();
      }

      function editPlan(plan) {
        document.getElementById('modal-title').textContent = 'Edit Plan';
        document.getElementById('plan-form').action = '/api/plans/' + plan.id + '/update';
        document.getElementById('plan-name').value = plan.name;
        document.getElementById('plan-yearly').value = plan.price_yearly;
        document.getElementById('plan-monthly').value = plan.price_monthly;
        document.getElementById('plan-users').value = plan.max_users;
        document.getElementById('plan-billing').value = plan.billing_cycle;
        document.getElementById('add-plan-modal').classList.remove('hidden');
      }
    </script>
  </body>
</html>
