<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | CrmOne</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brandBlue: "#1a73e8",
              brandOrange: "#f97316",
            },
          },
        },
      };
    </script>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900">
    <div class="flex min-h-screen">
      <aside class="hidden w-72 flex-col bg-slate-950 px-6 py-8 text-white lg:flex">
        <div>
          <div class="inline-flex rounded-full bg-brandBlue/20 px-4 py-1 text-sm font-semibold text-blue-200">
            CrmOne
          </div>
          <h2 class="mt-4 text-2xl font-bold">Admin Panel</h2>
        </div>

        <nav class="mt-10 space-y-2">
          <a href="/api/dashboard" class="block rounded-2xl bg-brandBlue px-4 py-3 font-medium text-white">Dashboard</a>
          <a href="/api/users" class="block rounded-2xl px-4 py-3 font-medium text-slate-300 transition hover:bg-slate-900 hover:text-white">Users</a>
          <a href="/api/companies" class="block rounded-2xl px-4 py-3 font-medium text-slate-300 transition hover:bg-slate-900 hover:text-white">Companies</a>
          <a href="/api/plans" class="block rounded-2xl px-4 py-3 font-medium text-slate-300 transition hover:bg-slate-900 hover:text-white">Plans</a>
        </nav>

        <form action="/api/logout" method="POST" class="mt-auto">
          <button class="w-full rounded-2xl border border-slate-700 px-4 py-3 text-left font-medium text-slate-300 transition hover:border-slate-500 hover:text-white">
            Logout
          </button>
        </form>
      </aside>

      <main class="flex-1 p-4 sm:p-8">
        <div class="mb-8 flex flex-col gap-4 rounded-3xl bg-white p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-medium uppercase tracking-[0.2em] text-brandOrange">Overview</p>
            <h1 class="mt-2 text-3xl font-bold">Dashboard</h1>
          </div>
          <div class="rounded-2xl bg-slate-100 px-5 py-3 text-sm text-slate-600">
            Signed in as <span class="font-semibold text-slate-900"><%= currentAdmin.name %></span>
          </div>
        </div>

        <% if (successMessages.length) { %>
          <div class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
            <%= successMessages[0] %>
          </div>
        <% } %>

        <% if (errorMessages.length) { %>
          <div class="mb-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <%= errorMessages[0] %>
          </div>
        <% } %>

        <section class="grid gap-5 md:grid-cols-3">
          <article class="rounded-3xl bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Total Users</p>
            <h2 class="mt-4 text-4xl font-bold"><%= stats.total_users %></h2>
          </article>
          <article class="rounded-3xl bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Active Users</p>
            <h2 class="mt-4 text-4xl font-bold text-emerald-600"><%= stats.active_users %></h2>
          </article>
          <article class="rounded-3xl bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Inactive Users</p>
            <h2 class="mt-4 text-4xl font-bold text-brandOrange"><%= stats.inactive_users %></h2>
          </article>
        </section>

        <section class="mt-8 rounded-3xl bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium uppercase tracking-[0.2em] text-brandOrange">Latest registrations</p>
              <h2 class="mt-2 text-2xl font-bold">Recent users</h2>
            </div>
            <a href="/api/users" class="rounded-full bg-brandBlue px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">
              Manage users
            </a>
          </div>

          <div class="mt-6 overflow-x-auto">
            <table class="min-w-full text-left text-sm">
              <thead class="border-b border-slate-200 text-slate-500">
                <tr>
                  <th class="pb-3 pr-6 font-medium">Company</th>
                  <th class="pb-3 pr-6 font-medium">Plan</th>
                  <th class="pb-3 pr-6 font-medium">Status</th>
                  <th class="pb-3 font-medium">Registered</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% recentUsers.forEach((user) => { %>
                  <tr>
                    <td class="py-4 pr-6">
                      <p class="font-semibold text-slate-900"><%= user.company_name %></p>
                      <p class="text-slate-500"><%= user.email %></p>
                    </td>
                    <td class="py-4 pr-6 text-slate-600"><%= user.plan_name || "N/A" %></td>
                    <td class="py-4 pr-6">
                      <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= user.is_active ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                        <%= user.is_active ? "Active" : "Inactive" %>
                      </span>
                    </td>
                    <td class="py-4 text-slate-600"><%= new Date(user.created_at).toLocaleDateString() %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
