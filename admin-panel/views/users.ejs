<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | CrmOne</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brandBlue: "#1a73e8",
              brandOrange: "#f97316",
            },
          },
        },
      };
    </script>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900">
    <div class="flex min-h-screen">
      <aside class="hidden w-72 flex-col bg-slate-950 px-6 py-8 text-white lg:flex">
        <div>
          <div class="inline-flex rounded-full bg-brandBlue/20 px-4 py-1 text-sm font-semibold text-blue-200">
            CrmOne
          </div>
          <h2 class="mt-4 text-2xl font-bold">Admin Panel</h2>
        </div>

        <nav class="mt-10 space-y-2">
          <a href="/api/dashboard" class="block rounded-2xl px-4 py-3 font-medium text-slate-300 transition hover:bg-slate-900 hover:text-white">Dashboard</a>
          <a href="/api/users" class="block rounded-2xl bg-brandBlue px-4 py-3 font-medium text-white">Users</a>
        </nav>

        <form action="/api/logout" method="POST" class="mt-auto">
          <button class="w-full rounded-2xl border border-slate-700 px-4 py-3 text-left font-medium text-slate-300 transition hover:border-slate-500 hover:text-white">
            Logout
          </button>
        </form>
      </aside>

      <main class="flex-1 p-4 sm:p-8">
        <div class="mb-8 flex flex-col gap-4 rounded-3xl bg-white p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-medium uppercase tracking-[0.2em] text-brandOrange">Accounts</p>
            <h1 class="mt-2 text-3xl font-bold">Users</h1>
          </div>
          <div class="rounded-2xl bg-slate-100 px-5 py-3 text-sm text-slate-600">
            Signed in as <span class="font-semibold text-slate-900"><%= currentAdmin.name %></span>
          </div>
        </div>

        <% if (successMessages.length) { %>
          <div class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
            <%= successMessages[0] %>
          </div>
        <% } %>

        <% if (errorMessages.length) { %>
          <div class="mb-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <%= errorMessages[0] %>
          </div>
        <% } %>

        <section class="rounded-3xl bg-white p-6 shadow-sm">
          <div class="overflow-x-auto">
            <table class="min-w-full text-left text-sm">
              <thead class="border-b border-slate-200 text-slate-500">
                <tr>
                  <th class="pb-3 pr-6 font-medium">Company Name</th>
                  <th class="pb-3 pr-6 font-medium">Email</th>
                  <th class="pb-3 pr-6 font-medium">Phone</th>
                  <th class="pb-3 pr-6 font-medium">Country</th>
                  <th class="pb-3 pr-6 font-medium">Plan</th>
                  <th class="pb-3 pr-6 font-medium">Billing Cycle</th>
                  <th class="pb-3 pr-6 font-medium">Status</th>
                  <th class="pb-3 pr-6 font-medium">Registered At</th>
                  <th class="pb-3 font-medium">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% users.forEach((user) => { %>
                  <tr>
                    <td class="py-4 pr-6 font-semibold text-slate-900"><%= user.company_name %></td>
                    <td class="py-4 pr-6 text-slate-600"><%= user.email %></td>
                    <td class="py-4 pr-6 text-slate-600"><%= user.phone %></td>
                    <td class="py-4 pr-6 text-slate-600"><%= user.country %></td>
                    <td class="py-4 pr-6 text-slate-600"><%= user.plan_name || "N/A" %></td>
                    <td class="py-4 pr-6 capitalize text-slate-600"><%= user.billing_cycle %></td>
                    <td class="py-4 pr-6">
                      <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= user.is_active ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                        <%= user.is_active ? "Active" : "Inactive" %>
                      </span>
                    </td>
                    <td class="py-4 pr-6 text-slate-600"><%= new Date(user.created_at).toLocaleDateString() %></td>
                    <td class="py-4">
                      <div class="flex flex-wrap gap-2">
                        <% if (!user.is_active) { %>
                          <form action="/api/users/<%= user.id %>/activate" method="POST">
                            <button class="rounded-full bg-emerald-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-emerald-700">
                              Activate
                            </button>
                          </form>
                        <% } else { %>
                          <form action="/api/users/<%= user.id %>/deactivate" method="POST">
                            <button class="rounded-full bg-slate-500 px-3 py-2 text-xs font-semibold text-white transition hover:bg-slate-600">
                              Deactivate
                            </button>
                          </form>
                        <% } %>
                        <form action="/api/users/<%= user.id %>/delete" method="POST" onsubmit="return confirm('Delete this user permanently?');">
                          <button class="rounded-full bg-red-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-red-700">
                            Delete
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
