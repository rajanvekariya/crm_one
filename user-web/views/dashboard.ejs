<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | CrmOne</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brandBlue: "#1a73e8",
              brandOrange: "#f97316",
              brandNavy: "#0f172a",
            },
          },
        },
      };
    </script>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900">
    <header class="border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
        <div class="flex items-center justify-between gap-4">
          <a href="/dashboard" class="text-2xl font-black text-brandBlue">CrmOne</a>
          <form action="/logout" method="POST" class="lg:hidden">
            <button class="rounded-full bg-brandBlue px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700">
              Log Out
            </button>
          </form>
        </div>
        <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium text-slate-600 lg:gap-8">
          <a href="/dashboard" class="transition hover:text-brandBlue">Home</a>
          <a href="/signup#features" class="transition hover:text-brandBlue">Features</a>
          <a href="/signup#agency" class="transition hover:text-brandBlue">Agency</a>
          <a href="/signup#pricing" class="transition hover:text-brandBlue">Pricing</a>
          <a href="/contact" class="transition hover:text-brandBlue">Contact Us</a>
        </nav>
        <form action="/logout" method="POST" class="hidden lg:block">
          <button class="rounded-full bg-brandBlue px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700">
            Log Out
          </button>
        </form>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <section class="rounded-[2rem] bg-brandNavy p-6 text-white shadow-2xl shadow-slate-300/60 sm:p-8">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-brandOrange">Welcome</p>
        <h1 class="mt-3 text-3xl font-bold sm:text-4xl"><%= user.company_name %></h1>
        <p class="mt-3 max-w-2xl text-sm text-slate-300 sm:text-base">
          Your CrmOne workspace is active and ready. Here’s a quick summary of your current plan and account access.
        </p>
      </section>

      <section class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-3xl bg-white p-6 shadow-sm">
          <p class="text-sm text-slate-500">Plan</p>
          <h2 class="mt-4 text-2xl font-bold"><%= user.plan_name || "N/A" %></h2>
        </article>
        <article class="rounded-3xl bg-white p-6 shadow-sm">
          <p class="text-sm text-slate-500">Billing Cycle</p>
          <h2 class="mt-4 text-2xl font-bold capitalize"><%= user.billing_cycle %></h2>
        </article>
        <article class="rounded-3xl bg-white p-6 shadow-sm">
          <p class="text-sm text-slate-500">Users Allowed</p>
          <h2 class="mt-4 text-2xl font-bold"><%= user.max_users || 0 %></h2>
        </article>
        <article class="rounded-3xl bg-white p-6 shadow-sm">
          <p class="text-sm text-slate-500">Member Since</p>
          <h2 class="mt-4 text-2xl font-bold"><%= new Date(user.created_at).toLocaleDateString() %></h2>
        </article>
      </section>
    </main>

    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-6 text-sm text-slate-500 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
        <div class="flex flex-wrap items-center gap-3">
          <span>Terms &amp; Conditions</span>
          <span>Privacy Policy</span>
          <span>Copyright CrmOne.Com © 2022</span>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <span>+91 7079409099</span>
          <span>+91 7227045458</span>
          <span>Facebook</span>
          <span>Instagram</span>
          <span>LinkedIn</span>
          <span>Twitter</span>
          <span>Pinterest</span>
        </div>
      </div>
    </footer>
  </body>
</html>
