<% const navUser=(typeof user !=='undefined' && user) || (typeof currentUser !=='undefined' && currentUser) || null;
  const currentPageValue=typeof currentPage !=='undefined' ? currentPage : '' ; const nameSource=navUser &&
  (navUser.name || navUser.email || 'User' ) || 'User' ; const displayName=nameSource.includes('@') ?
  nameSource.split('@')[0] : nameSource; const initials=displayName .replace(/[._-]+/g, ' ' ) .split(/\s+/)
  .filter(Boolean) .slice(0, 2) .map((part)=> part.charAt(0))
  .join('')
  .toUpperCase() || 'U';
  %>

  <nav class="navbar" aria-label="Primary">
    <div class="navbar-left">
      <a href="/dashboard" class="brand" aria-label="CrmOne home">
        <span class="brand__logo"><span>Crm</span><span class="brand__o">O</span><span>ne</span></span>
        <span class="brand__tag">One Stop Solutions</span>
      </a>

      <div class="navbar-nav">
        <a href="#" class="nav-link">
          <span class="nav-icon" aria-hidden="true">💬</span>
          <span>Conversations</span>
        </a>
        <a href="#" class="nav-link">
          <span class="nav-icon" aria-hidden="true">👥</span>
          <span>Contacts</span>
          <span class="nav-arrow" aria-hidden="true">▾</span>
        </a>
        <a href="#" class="nav-link">
          <span class="nav-icon" aria-hidden="true">📣</span>
          <span>Marketing</span>
          <span class="nav-arrow" aria-hidden="true">▾</span>
        </a>

        <div class="nav-dropdown" id="salesDropdown">
          <button class="nav-link dropdown-trigger <%= currentPageValue === 'followup' ? 'active-parent' : '' %>"
            type="button" onclick="toggleDropdown('salesDropdown')" id="salesTrigger" aria-haspopup="true"
            aria-expanded="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              aria-hidden="true">
              <polyline points="22,7 13.5,15.5 8.5,10.5 2,17"></polyline>
              <polyline points="16,7 22,7 22,13"></polyline>
            </svg>
            <span>Sales</span>
            <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" aria-hidden="true">
              <polyline points="6,9 12,15 18,9"></polyline>
            </svg>
          </button>

          <div class="dropdown-menu" id="salesDropdownMenu">
            <a href="/followup" class="dropdown-item <%= currentPageValue === 'followup' ? 'active' : '' %>">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              Follow-Up
            </a>
          </div>
        </div>

        <a href="#" class="nav-link">
          <span class="nav-icon" aria-hidden="true">⚙️</span>
          <span>Workflows</span>
        </a>
        <a href="#" class="nav-link">
          <span class="nav-icon" aria-hidden="true">📋</span>
          <span>Reports</span>
          <span class="nav-arrow" aria-hidden="true">▾</span>
        </a>

        <% if (navUser && navUser.role==='admin' ) { %>
          <a href="/team" class="nav-link <%= currentPageValue === 'team' ? 'active' : '' %>">
            <span class="nav-icon" aria-hidden="true">👥</span>
            <span>Team</span>
          </a>
          <% } %>
      </div>
    </div>

    <div class="navbar-right">
      <button class="icon-btn" type="button" aria-label="Notifications">
        <span aria-hidden="true">🔔</span>
        <span class="icon-badge"></span>
      </button>

      <button class="phone-btn" type="button" aria-label="Call">
        <span aria-hidden="true">📞</span>
      </button>

      <button class="user-pill" type="button" aria-label="User menu">
        <span class="avatar-circle">
          <%= initials %>
        </span>
        <span class="user-pill__name">
          <%= displayName %>
        </span>
        <span class="nav-arrow" aria-hidden="true">▾</span>
      </button>

      <button class="profile-chip" type="button" aria-label="Profile">
        <span class="profile-avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="M4.5 20c1.6-4 4.8-6 7.5-6s5.9 2 7.5 6" stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="profile-chip__name">
          <%= displayName %>
        </span>
        <span class="nav-arrow" aria-hidden="true">▾</span>
      </button>

      <button class="icon-btn icon-btn--outline" type="button" aria-label="More notifications">
        <span aria-hidden="true">🔔</span>
      </button>
    </div>
  </nav>

  <script>
    function toggleDropdown(id) {
      const el = document.getElementById(id);
      const isOpen = el.classList.contains('open');

      document.querySelectorAll('.nav-dropdown.open').forEach((dropdown) => {
        dropdown.classList.remove('open');
      });
      document.querySelectorAll('.dropdown-trigger[aria-expanded="true"]').forEach((trigger) => {
        trigger.setAttribute('aria-expanded', 'false');
      });

      if (!isOpen) {
        el.classList.add('open');
        const trigger = el.querySelector('.dropdown-trigger');
        if (trigger) trigger.setAttribute('aria-expanded', 'true');
      }
    }

    document.addEventListener('click', function (e) {
      if (!e.target.closest('.nav-dropdown')) {
        document.querySelectorAll('.nav-dropdown.open').forEach((dropdown) => {
          dropdown.classList.remove('open');
        });
        document.querySelectorAll('.dropdown-trigger[aria-expanded="true"]').forEach((trigger) => {
          trigger.setAttribute('aria-expanded', 'false');
        });
      }
    });

    (function () {
      const page = '<%= currentPageValue %>';
      const salesPages = ['followup'];
      if (salesPages.includes(page)) {
        const trigger = document.getElementById('salesTrigger');
        if (trigger) trigger.classList.add('active-parent');
      }
    })();
  </script>